{
  "name": "openagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenAgent — Vercel frontend + VPS API (wallet credits chat)",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "start:api": "SERVE_STATIC=0 node server/index.js",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
