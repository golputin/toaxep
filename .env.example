# ─── VPS API only (never commit real keys) ───
LLM_API_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=z-ai/glm-5.2
PORT=8787
DAILY_FREE_CREDITS=10

# Browser origins allowed to call this API (Vercel frontend)
# Comma-separated. Supports * wildcards.
ALLOWED_ORIGINS=https://*.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Keep 0 — frontend is on Vercel
SERVE_STATIC=0

RH_CHAIN_ID=4663
RH_RPC=https://rpc.mainnet.chain.robinhood.com
TREASURY=0x0000000000000000000000000000000000000000
CREDITS_PER_ETH=100000
MIN_TOPUP_ETH=0.005
ALLOW_DEMO_TOPUP=1

# ─── Vercel (Project → Settings → Environment Variables) ───
# VITE_API_BASE=http://YOUR_VPS_IP:8787
# (or https://api.yourdomain.com)
